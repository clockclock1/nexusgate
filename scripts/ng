#!/usr/bin/env bash
# NexusGate Linux manager - invoke as: ng
# Install self: curl -fsSL https://raw.githubusercontent.com/clockclock1/nexusgate/main/scripts/install-ng.sh | sudo bash

set -euo pipefail

NG_CMD_NAME="ng"
REPO="clockclock1/nexusgate"
GITHUB_API="https://api.github.com/repos/${REPO}"
GITHUB_RAW="https://raw.githubusercontent.com/${REPO}/main"

PREFIX="/opt/nexusgate"
BIN_DIR="${PREFIX}/bin"
SERVER_BIN="${BIN_DIR}/p2p-server"
EDGE_BIN="${BIN_DIR}/p2p-edge"
SERVER_CFG_DIR="${PREFIX}/server/config"
CLIENT_CFG_DIR="${PREFIX}/client/config"
SERVER_CFG="${SERVER_CFG_DIR}/server.toml"
CLIENT_CFG="${CLIENT_CFG_DIR}/edge.toml"
WEB_DIR="${PREFIX}/web"
WEB_CFG_DIR="${WEB_DIR}/config"
WEB_CFG="${WEB_CFG_DIR}/admin.toml"
WEB_BIN="${BIN_DIR}/p2p-admin"
DATA_DIR="${PREFIX}/data"
STATE_DIR="${PREFIX}/.state"
VERSION_FILE="${STATE_DIR}/version"
MIRROR_FILE="${STATE_DIR}/mirror"
SERVER_UNIT="nexusgate-server.service"
EDGE_UNIT="nexusgate-edge.service"
WEB_UNIT="nexusgate-web.service"
SYSUSER="nexusgate"
NG_LINK="/usr/local/bin/${NG_CMD_NAME}"
DEFAULT_WEB_PORT="8088"
DEFAULT_API_UPSTREAM="127.0.0.1:3000"

# GitHub 下载镜像前缀（把完整 https://github.com/... URL 接在后面）
# 可用环境变量 NG_MIRROR 覆盖，例如: export NG_MIRROR=https://ghproxy.net/
DEFAULT_MIRRORS=(
  "https://ghproxy.net/"
  "https://mirror.ghproxy.com/"
  "https://ghfast.top/"
  "https://gh.ddlc.top/"
  "https://gitclone.com/"
)

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
NC=$'\033[0m'

log()  { echo -e "${GREEN}[ng]${NC} $*"; }
warn() { echo -e "${YELLOW}[ng]${NC} $*"; }
err()  { echo -e "${RED}[ng]${NC} $*" >&2; }
die()  { err "$*"; exit 1; }

need_root() {
  if [[ ${EUID} -ne 0 ]]; then
    die "请使用 root 运行：sudo ng $*"
  fi
}

have_cmd() { command -v "$1" >/dev/null 2>&1; }

normalize_mirror() {
  local m="${1:-}"
  m="${m#"${m%%[![:space:]]*}"}"
  m="${m%"${m##*[![:space:]]}"}"
  [[ -z "$m" || "$m" == "official" || "$m" == "direct" || "$m" == "0" ]] && { echo ""; return; }
  [[ "$m" != http://* && "$m" != https://* ]] && m="https://${m}"
  m="${m%/}/"
  # gitclone 特殊路径
  if [[ "$m" == *gitclone.com/ ]]; then
    m="https://gitclone.com/"
  fi
  echo "$m"
}

saved_mirror() {
  if [[ -n "${NG_MIRROR:-}" ]]; then
    normalize_mirror "$NG_MIRROR"
    return
  fi
  if [[ -f "$MIRROR_FILE" ]]; then
    normalize_mirror "$(cat "$MIRROR_FILE" 2>/dev/null || true)"
    return
  fi
  echo ""
}

# 构建候选下载地址：优先官方，再首选镜像，再其它默认镜像
build_url_candidates() {
  local origin="$1"
  local preferred
  preferred="$(saved_mirror)"
  local -a out=()
  local m

  # 若用户设置了镜像，优先镜像再官方；否则官方优先
  if [[ -n "$preferred" ]]; then
    out+=("${preferred}${origin}")
    out+=("$origin")
  else
    out+=("$origin")
  fi

  for m in "${DEFAULT_MIRRORS[@]}"; do
    m="$(normalize_mirror "$m")"
    [[ -z "$m" ]] && continue
    [[ -n "$preferred" && "$m" == "$preferred" ]] && continue
    # gitclone: https://gitclone.com/github.com/...
    if [[ "$m" == "https://gitclone.com/" ]]; then
      if [[ "$origin" == https://github.com/* ]]; then
        out+=("https://gitclone.com/${origin#https://}")
      elif [[ "$origin" == https://raw.githubusercontent.com/* ]]; then
        out+=("https://gitclone.com/${origin#https://}")
      else
        # API 等走通用前缀镜像
        out+=("https://ghproxy.net/${origin}")
      fi
    else
      out+=("${m}${origin}")
    fi
  done

  # 去重保持顺序
  local -A seen=()
  local u
  for u in "${out[@]}"; do
    [[ -z "$u" ]] && continue
    [[ -n "${seen[$u]:-}" ]] && continue
    seen[$u]=1
    echo "$u"
  done
}

curl_try() {
  # curl_try URL DEST [extra curl args...]
  local url="$1"
  local dest="$2"
  shift 2
  if have_cmd curl; then
    curl -fL --connect-timeout 15 --max-time 600 --retry 0 --progress-bar -o "$dest" "$@" "$url"
  elif have_cmd wget; then
    wget -q --timeout=30 --tries=2 -O "$dest" "$url"
  else
    return 1
  fi
}

# 任意原始 URL 下载，官方失败则自动切镜像重试
download_url_failover() {
  local origin="$1"
  local dest="$2"
  shift 2 || true
  local tmp cand ok=0
  tmp="${dest}.ngdl.$$"
  rm -f "$tmp"

  log "下载: ${origin}"
  while IFS= read -r cand; do
    [[ -z "$cand" ]] && continue
    if [[ "$cand" == "$origin" ]]; then
      log "尝试官方源..."
    else
      warn "官方/前序失败，切换镜像: ${cand}"
    fi
    if curl_try "$cand" "$tmp"; then
      if [[ -s "$tmp" ]]; then
        mv -f "$tmp" "$dest"
        ok=1
        log "下载成功"
        break
      fi
    fi
    rm -f "$tmp"
  done < <(build_url_candidates "$origin")

  ((ok)) || die "所有源均下载失败: ${origin}
可设置镜像后重试: sudo ng mirror
或: export NG_MIRROR=https://ghproxy.net/"
}

# GET 文本（API/HTML），带镜像故障转移；成功则打印到 stdout
curl_text_failover() {
  local origin="$1"
  local cand body
  while IFS= read -r cand; do
    [[ -z "$cand" ]] && continue
    body=""
    if have_cmd curl; then
      body="$(curl -fsSL --connect-timeout 12 --max-time 60 --retry 0 "$cand" 2>/dev/null)" || true
    elif have_cmd wget; then
      body="$(wget -q --timeout=20 --tries=2 -O - "$cand" 2>/dev/null)" || true
    fi
    if [[ -n "$body" ]]; then
      printf '%s' "$body"
      return 0
    fi
  done < <(build_url_candidates "$origin")
  return 1
}

detect_arch() {
  local m
  m="$(uname -m)"
  case "$m" in
    x86_64|amd64) echo "amd64" ;;
    aarch64|arm64) echo "arm64" ;;
    *) die "不支持的架构: $m（仅 linux-amd64 / linux-arm64）" ;;
  esac
}

try_install_pkg() {
  local pkg="$1"
  if have_cmd apt-get; then
    DEBIAN_FRONTEND=noninteractive apt-get update -qq >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$pkg" >/dev/null 2>&1
  elif have_cmd dnf; then
    dnf install -y -q "$pkg" >/dev/null 2>&1
  elif have_cmd yum; then
    yum install -y -q "$pkg" >/dev/null 2>&1
  elif have_cmd apk; then
    apk add --quiet "$pkg" >/dev/null 2>&1
  else
    return 1
  fi
}

ensure_tools() {
  if ! have_cmd curl; then
    warn "未检测到 curl，尝试自动安装..."
    if try_install_pkg curl && have_cmd curl; then
      log "已安装 curl"
    elif have_cmd wget; then
      warn "将使用 wget 作为下载后备"
    else
      die "缺少 curl（也无 wget）。请先安装: apt-get install -y curl"
    fi
  fi
  have_cmd systemctl || die "缺少 systemd（systemctl）"
}

ensure_web_tools() {
  ensure_tools
}

ensure_dirs() {
  mkdir -p "$BIN_DIR" "$SERVER_CFG_DIR" "$CLIENT_CFG_DIR" "$DATA_DIR" "$STATE_DIR"
  mkdir -p "$WEB_DIR" "$WEB_CFG_DIR"
}

ensure_user() {
  if ! id -u "$SYSUSER" >/dev/null 2>&1; then
    useradd --system --home-dir "$PREFIX" --shell /usr/sbin/nologin "$SYSUSER" 2>/dev/null \
      || useradd --system --home-dir "$PREFIX" --shell /bin/false "$SYSUSER"
    log "已创建系统用户 ${SYSUSER}"
  fi
  chown -R "${SYSUSER}:${SYSUSER}" "$PREFIX" 2>/dev/null || true
}

fix_ownership() {
  chown -R "${SYSUSER}:${SYSUSER}" "$PREFIX"
  chmod 755 "$BIN_DIR" 2>/dev/null || true
  # 注意: 在 set -e 下，函数末尾的 `[[ ]] && cmd` 若条件为假会让函数返回 1，导致安装中断
  if [[ -f "$SERVER_BIN" ]]; then chmod 755 "$SERVER_BIN"; fi
  if [[ -f "$EDGE_BIN" ]]; then chmod 755 "$EDGE_BIN"; fi
  if [[ -f "$WEB_BIN" ]]; then chmod 755 "$WEB_BIN"; fi
  return 0
}

latest_tag() {
  local json tag loc
  # 1) GitHub API（含镜像故障转移）
  if json="$(curl_text_failover "${GITHUB_API}/releases/latest" 2>/dev/null)"; then
    tag="$(printf '%s' "$json" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
    if [[ -n "$tag" ]]; then
      echo "$tag"
      return 0
    fi
  fi
  # 2) releases/latest 重定向解析 tag
  while IFS= read -r cand; do
    [[ -z "$cand" ]] && continue
    loc="$(curl -fsSI --connect-timeout 12 --max-time 30 -o /dev/null -w '%{url_effective}' "$cand" 2>/dev/null || true)"
    if [[ "$loc" =~ /tag/([^/[:space:]]+) ]]; then
      echo "${BASH_REMATCH[1]}"
      return 0
    fi
    loc="$(curl -fsSI --connect-timeout 12 --max-time 30 "$cand" 2>/dev/null | tr -d '\r' | awk 'tolower($1)=="location:"{print $2; exit}')"
    if [[ "$loc" =~ /tag/([^/[:space:]]+) ]]; then
      echo "${BASH_REMATCH[1]}"
      return 0
    fi
  done < <(build_url_candidates "https://github.com/${REPO}/releases/latest")
  return 1
}

release_asset_origin_url() {
  local tag="$1"
  local asset="$2"
  echo "https://github.com/${REPO}/releases/download/${tag}/${asset}"
}

download_asset() {
  local asset="$1"
  local dest="$2"
  local tag url
  tag="$(latest_tag)" || die "无法获取最新 Release 版本（官方与镜像均失败）
可执行: sudo ng mirror 设置镜像源后重试"
  [[ -n "$tag" ]] || die "最新版本号为空"
  url="$(release_asset_origin_url "$tag" "$asset")"
  log "目标版本: ${tag}  资产: ${asset}"
  download_url_failover "$url" "$dest"
  chmod 755 "$dest"
}

cmd_mirror() {
  ensure_dirs
  local cur
  cur="$(saved_mirror)"
  echo -e "${BOLD}GitHub 镜像源设置${NC}"
  echo
  if [[ -n "${NG_MIRROR:-}" ]]; then
    echo -e "当前生效: ${CYAN}${NG_MIRROR}${NC}  (环境变量 NG_MIRROR，优先于本地配置)"
  elif [[ -n "$cur" ]]; then
    echo -e "当前生效: ${CYAN}${cur}${NC}  (已保存到 ${MIRROR_FILE})"
  else
    echo -e "当前生效: ${CYAN}官方优先，失败自动切换默认镜像${NC}"
  fi
  echo
  echo "说明: 安装/更新时先走优先源，失败后自动按列表故障转移重试。"
  echo
  echo "  0) 官方优先（失败自动故障转移到镜像）  [推荐]"
  local i=1 m
  for m in "${DEFAULT_MIRRORS[@]}"; do
    echo "  ${i}) 优先使用 ${m}"
    i=$((i + 1))
  done
  echo "  ${i}) 自定义镜像前缀"
  echo "  c) 清除已保存镜像"
  echo
  echo -n "请选择: "
  local choice custom idx
  read -r choice
  case "$choice" in
    0|"")
      need_root "mirror"
      rm -f "$MIRROR_FILE"
      log "已设为官方优先 + 镜像故障转移"
      ;;
    c|C)
      need_root "mirror"
      rm -f "$MIRROR_FILE"
      log "已清除本地镜像配置"
      ;;
    [1-9]|[1-9][0-9])
      idx=$((choice))
      if (( idx >= 1 && idx <= ${#DEFAULT_MIRRORS[@]} )); then
        need_root "mirror"
        normalize_mirror "${DEFAULT_MIRRORS[$((idx - 1))]}" >"$MIRROR_FILE"
        chmod 644 "$MIRROR_FILE" 2>/dev/null || true
        log "已保存优先镜像: $(cat "$MIRROR_FILE")"
      elif (( idx == ${#DEFAULT_MIRRORS[@]} + 1 )); then
        echo -n "输入镜像前缀 (如 https://ghproxy.net/ ): "
        read -r custom
        need_root "mirror"
        normalize_mirror "$custom" >"$MIRROR_FILE"
        chmod 644 "$MIRROR_FILE" 2>/dev/null || true
        [[ -n "$(cat "$MIRROR_FILE")" ]] || die "镜像前缀无效"
        log "已保存优先镜像: $(cat "$MIRROR_FILE")"
      else
        die "无效选项"
      fi
      ;;
    *)
      die "无效选项"
      ;;
  esac
  echo
  log "也可临时指定: NG_MIRROR=https://ghproxy.net/ sudo -E ng update-server"
}

cmd_test_mirror() {
  ensure_tools
  local tag origin
  log "测试获取最新版本号..."
  if tag="$(latest_tag)"; then
    log "OK 最新版本: ${tag}"
  else
    die "获取版本失败"
  fi
  origin="$(release_asset_origin_url "$tag" "nexusgate-server-linux-$(detect_arch)")"
  log "将按故障转移顺序探测（不完整下载）:"
  local cand code
  while IFS= read -r cand; do
    [[ -z "$cand" ]] && continue
    code="$(curl -o /dev/null -sS -L --connect-timeout 10 --max-time 20 -w '%{http_code}' "$cand" || echo 000)"
    echo "  HTTP ${code}  ${cand}"
  done < <(build_url_candidates "$origin")
}

write_server_unit() {
  cat >"/etc/systemd/system/${SERVER_UNIT}" <<EOF
[Unit]
Description=NexusGate Server (Super Node)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${SYSUSER}
Group=${SYSUSER}
WorkingDirectory=${PREFIX}
ExecStart=${SERVER_BIN} --config ${SERVER_CFG}
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
Environment=RUST_LOG=info
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF
}

write_edge_unit() {
  cat >"/etc/systemd/system/${EDGE_UNIT}" <<EOF
[Unit]
Description=NexusGate Edge Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${SYSUSER}
Group=${SYSUSER}
WorkingDirectory=${PREFIX}
ExecStart=${EDGE_BIN} --config ${CLIENT_CFG}
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
Environment=RUST_LOG=info
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF
}

write_web_config_file() {
  local listen="$1" listen_port="$2" api_upstream="$3"
  mkdir -p "$WEB_CFG_DIR"
  cat >"$WEB_CFG" <<EOF
listen = "${listen}"
listen_port = ${listen_port}
api_upstream = "${api_upstream}"
EOF
}

write_web_unit() {
  cat >"/etc/systemd/system/${WEB_UNIT}" <<EOF
[Unit]
Description=NexusGate Web Admin Panel (embedded SPA + API proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${SYSUSER}
Group=${SYSUSER}
WorkingDirectory=${WEB_DIR}
ExecStart=${WEB_BIN} --config ${WEB_CFG}
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
Environment=RUST_LOG=info
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF
}

configure_web_interactive() {
  ensure_dirs
  echo
  echo -e "${BOLD}======== 管理面板配置向导 ========${NC}"
  echo "  二进制: ${WEB_BIN}（内嵌前端，反代 /api 与 /ws）"
  echo "  配置文件: ${WEB_CFG}"
  echo

  local listen listen_port api_upstream def_api
  def_api="$DEFAULT_API_UPSTREAM"
  if [[ -f "$SERVER_CFG" ]]; then
    local ap
    ap="$(toml_get "$SERVER_CFG" api_port 3000)"
    def_api="127.0.0.1:${ap}"
  fi
  listen="$(ask_input "监听地址 listen" "$(toml_get "$WEB_CFG" listen "0.0.0.0")" 1)"
  listen_port="$(ask_input "面板端口 listen_port" "$(toml_get "$WEB_CFG" listen_port "$DEFAULT_WEB_PORT")" 1)"
  api_upstream="$(ask_input "API 反代地址 api_upstream (host:port)" "$(toml_get "$WEB_CFG" api_upstream "$def_api")" 1)"

  write_web_config_file "$listen" "$listen_port" "$api_upstream"
  echo
  log "管理面板配置已保存: ${WEB_CFG}"
  echo -e "  访问地址: http://${listen}:${listen_port}"
  echo -e "  API 上游: ${api_upstream}"
}

install_web_bin_from_release() {
  local arch tag asset
  arch="$(detect_arch)"
  tag="$(latest_tag)"
  [[ -n "$tag" ]] || die "无法获取最新 Release 版本"
  asset="nexusgate-admin-linux-${arch}"
  ensure_dirs
  log "下载管理面板二进制 ${asset} (${tag})..."
  download_asset "$asset" "$WEB_BIN"
  echo "$tag" >"${WEB_DIR}/version"
  echo "$tag" >"$VERSION_FILE"
  log "管理面板二进制已安装: ${WEB_BIN}"
}

# ---------- 交互式配置（逐项提问，不直接打开编辑器）----------

ask_input() {
  # ask_input "提示" "默认值"(可空) [require=1]
  local prompt="$1"
  local def="${2:-}"
  local require="${3:-0}"
  local ans
  while true; do
    if [[ -n "$def" ]]; then
      read -r -p "  ${prompt} [${def}]: " ans || true
      ans="${ans:-$def}"
    else
      read -r -p "  ${prompt}: " ans || true
    fi
    if [[ -n "$ans" || "$require" != "1" ]]; then
      printf '%s' "$ans"
      return 0
    fi
    warn "此项不能为空，请重新输入"
  done
}

ask_yn() {
  # ask_yn "提示" "Y|N"  -> 返回 0=yes
  local prompt="$1"
  local def="${2:-Y}"
  local hint ans
  if [[ "$def" =~ ^[Yy]$ ]]; then hint="Y/n"; else hint="y/N"; fi
  read -r -p "  ${prompt} [${hint}]: " ans || true
  ans="${ans:-$def}"
  [[ "$ans" =~ ^[Yy]$ ]]
}

toml_get() {
  local file="$1" key="$2" def="${3:-}"
  local line val
  [[ -f "$file" ]] || { printf '%s' "$def"; return 0; }
  line="$(grep -E "^[[:space:]]*${key}[[:space:]]*=" "$file" 2>/dev/null | head -n1 || true)"
  [[ -z "$line" ]] && { printf '%s' "$def"; return 0; }
  val="${line#*=}"
  val="${val#"${val%%[![:space:]]*}"}"
  val="${val%"${val##*[![:space:]]}"}"
  if [[ "$val" == \"*\" && "$val" == *\" ]]; then
    val="${val:1:$((${#val} - 2))}"
  fi
  printf '%s' "${val:-$def}"
}

rand_secret() {
  if have_cmd openssl; then
    openssl rand -hex 16
  elif [[ -r /dev/urandom ]] && have_cmd od; then
    od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n'
  else
    echo "nexusgate-change-me-$(date +%s)"
  fi
}

toml_escape() {
  # 转义双引号与反斜杠，供写入 TOML 字符串
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

write_server_config_file() {
  local listen="$1" control_port="$2" data_port="$3" gateway_port="$4" api_port="$5"
  local database_url="$6" jwt_secret="$7" jwt_ttl="$8" admin_user="$9" admin_password="${10}"
  local max_connections="${11}" enable_relay="${12}" enable_p2p="${13}"
  listen="$(toml_escape "$listen")"
  database_url="$(toml_escape "$database_url")"
  jwt_secret="$(toml_escape "$jwt_secret")"
  admin_user="$(toml_escape "$admin_user")"
  admin_password="$(toml_escape "$admin_password")"
  cat >"$SERVER_CFG" <<EOF
listen = "${listen}"
control_port = ${control_port}
data_port = ${data_port}
gateway_port = ${gateway_port}
api_port = ${api_port}
database_url = "${database_url}"
jwt_secret = "${jwt_secret}"
jwt_ttl_secs = ${jwt_ttl}
admin_user = "${admin_user}"
admin_password = "${admin_password}"
max_connections = ${max_connections}
enable_relay = ${enable_relay}
enable_p2p = ${enable_p2p}
EOF
}

configure_server_interactive() {
  ensure_dirs
  echo
  echo -e "${BOLD}======== 服务端配置向导 ========${NC}"
  echo "  请逐项确认（直接回车 = 使用方括号内默认值）"
  echo "  配置文件将写入: ${SERVER_CFG}"
  echo

  local listen control_port data_port gateway_port api_port
  local database_url jwt_secret jwt_ttl admin_user admin_password
  local max_connections enable_relay enable_p2p
  local def_relay=Y def_p2p=Y
  local cur

  listen="$(ask_input "监听地址 listen" "$(toml_get "$SERVER_CFG" listen "0.0.0.0")" 1)"
  control_port="$(ask_input "控制面端口 control_port" "$(toml_get "$SERVER_CFG" control_port 7000)" 1)"
  data_port="$(ask_input "数据面端口 data_port" "$(toml_get "$SERVER_CFG" data_port 7001)" 1)"
  gateway_port="$(ask_input "网关端口 gateway_port" "$(toml_get "$SERVER_CFG" gateway_port 8080)" 1)"
  api_port="$(ask_input "管理 API 端口 api_port" "$(toml_get "$SERVER_CFG" api_port 3000)" 1)"
  database_url="$(ask_input "数据库 URL database_url" "$(toml_get "$SERVER_CFG" database_url "sqlite:///opt/nexusgate/data/p2p.db")" 1)"
  jwt_secret="$(ask_input "JWT 密钥 jwt_secret" "$(toml_get "$SERVER_CFG" jwt_secret "$(rand_secret)")" 1)"
  jwt_ttl="$(ask_input "JWT 有效期秒数 jwt_ttl_secs" "$(toml_get "$SERVER_CFG" jwt_ttl_secs 86400)" 1)"
  admin_user="$(ask_input "管理员用户名 admin_user" "$(toml_get "$SERVER_CFG" admin_user "admin")" 1)"
  admin_password="$(ask_input "管理员密码 admin_password" "$(toml_get "$SERVER_CFG" admin_password "admin123")" 1)"
  max_connections="$(ask_input "最大连接数 max_connections" "$(toml_get "$SERVER_CFG" max_connections 100000)" 1)"

  cur="$(toml_get "$SERVER_CFG" enable_relay true)"
  [[ "$cur" == "false" || "$cur" == "0" ]] && def_relay=N
  cur="$(toml_get "$SERVER_CFG" enable_p2p true)"
  [[ "$cur" == "false" || "$cur" == "0" ]] && def_p2p=N

  if ask_yn "启用中继 enable_relay" "$def_relay"; then
    enable_relay=true
  else
    enable_relay=false
  fi
  if ask_yn "启用 P2P enable_p2p" "$def_p2p"; then
    enable_p2p=true
  else
    enable_p2p=false
  fi

  write_server_config_file \
    "$listen" "$control_port" "$data_port" "$gateway_port" "$api_port" \
    "$database_url" "$jwt_secret" "$jwt_ttl" "$admin_user" "$admin_password" \
    "$max_connections" "$enable_relay" "$enable_p2p"

  echo
  log "服务端配置已保存: ${SERVER_CFG}"
  echo -e "  API: http://${listen}:${api_port}  Gateway: :${gateway_port}"
  echo -e "  Control: :${control_port}  Data: :${data_port}"
  echo -e "  管理员: ${admin_user} / ${admin_password}"
}

write_client_config_file() {
  local node_id="$1" token="$2" server="$3" control_port="$4" data_port="$5" name="$6"
  local services_block="$7"
  node_id="$(toml_escape "$node_id")"
  token="$(toml_escape "$token")"
  server="$(toml_escape "$server")"
  name="$(toml_escape "$name")"
  cat >"$CLIENT_CFG" <<EOF
node_id = "${node_id}"
token = "${token}"
server = "${server}"
control_port = ${control_port}
data_port = ${data_port}
name = "${name}"
${services_block}
EOF
}

configure_client_interactive() {
  ensure_dirs
  echo
  echo -e "${BOLD}======== 客户端配置向导 ========${NC}"
  echo "  请逐项确认（直接回车 = 使用方括号内默认值）"
  echo "  配置文件将写入: ${CLIENT_CFG}"
  echo "  node_id / token 请在管理面板创建节点后获取"
  echo

  local node_id token server control_port data_port name
  local sid sname proto laddr services_block="" n=0

  node_id="$(ask_input "节点 ID node_id" "$(toml_get "$CLIENT_CFG" node_id "edge-demo")" 1)"
  token="$(ask_input "节点 Token token" "$(toml_get "$CLIENT_CFG" token "")" 1)"
  server="$(ask_input "服务端地址 server" "$(toml_get "$CLIENT_CFG" server "127.0.0.1")" 1)"
  control_port="$(ask_input "控制面端口 control_port" "$(toml_get "$CLIENT_CFG" control_port 7000)" 1)"
  data_port="$(ask_input "数据面端口 data_port" "$(toml_get "$CLIENT_CFG" data_port 7001)" 1)"
  name="$(ask_input "节点显示名 name" "$(toml_get "$CLIENT_CFG" name "demo-edge")" 1)"

  echo
  echo -e "${BOLD}本地服务映射（可配置多个）${NC}"
  while true; do
    n=$((n + 1))
    echo "  ---- 第 ${n} 个服务 ----"
    if ((n == 1)); then
      sid="$(ask_input "service_id" "web" 1)"
      sname="$(ask_input "name" "local-web" 1)"
      proto="$(ask_input "protocol" "tcp" 1)"
      laddr="$(ask_input "local_addr (本机回源)" "127.0.0.1:8000" 1)"
    else
      sid="$(ask_input "service_id" "" 1)"
      sname="$(ask_input "name" "$sid" 1)"
      proto="$(ask_input "protocol" "tcp" 1)"
      laddr="$(ask_input "local_addr (本机回源)" "" 1)"
    fi
    services_block+="
[[services]]
service_id = \"$(toml_escape "$sid")\"
name = \"$(toml_escape "$sname")\"
protocol = \"$(toml_escape "$proto")\"
local_addr = \"$(toml_escape "$laddr")\"
"
    if ask_yn "继续添加下一个本地服务?" "N"; then
      continue
    fi
    break
  done

  write_client_config_file "$node_id" "$token" "$server" "$control_port" "$data_port" "$name" "$services_block"

  echo
  log "客户端配置已保存: ${CLIENT_CFG}"
  echo -e "  节点: ${node_id} @ ${server}:${control_port}"
  echo -e "  已配置 ${n} 个本地服务"
  if [[ "$token" == "REPLACE_WITH_TOKEN_FROM_ADMIN" || -z "$token" ]]; then
    warn "token 仍为占位/空，连接服务端前请到管理面板创建节点并填入真实 token"
  fi
}

unit_exists() { [[ -f "/etc/systemd/system/$1" ]]; }

svc_do() {
  local action="$1"
  local unit="$2"
  systemctl daemon-reload
  systemctl "$action" "$unit"
}

installed_server() { [[ -x "$SERVER_BIN" ]] && unit_exists "$SERVER_UNIT"; }
installed_client() { [[ -x "$EDGE_BIN" ]] && unit_exists "$EDGE_UNIT"; }
installed_web() { [[ -x "$WEB_BIN" ]] && unit_exists "$WEB_UNIT"; }

cmd_install_server() {
  need_root "install-server"
  ensure_tools
  ensure_dirs
  ensure_user
  local arch tag asset
  arch="$(detect_arch)"
  tag="$(latest_tag)"
  [[ -n "$tag" ]] || die "无法获取最新 Release 版本"
  asset="nexusgate-server-linux-${arch}"
  download_asset "$asset" "$SERVER_BIN"

  echo
  log "二进制已就绪，开始逐项配置服务端..."
  configure_server_interactive

  write_server_unit
  fix_ownership
  echo "$tag" >"$VERSION_FILE"
  systemctl daemon-reload

  echo
  if ask_yn "写入 systemd 并启用开机自启，立即启动服务端?" "Y"; then
    systemctl enable "$SERVER_UNIT"
    systemctl restart "$SERVER_UNIT" || systemctl start "$SERVER_UNIT"
    if systemctl is-active --quiet "$SERVER_UNIT"; then
      log "服务端已安装并开机自启（版本 ${tag}）"
      log "API/Gateway/Control/Data 端口以刚才配置为准"
    else
      die "服务端启动失败，请查看: journalctl -u ${SERVER_UNIT} -xe"
    fi
  else
    systemctl enable "$SERVER_UNIT" || true
    log "服务端已安装（版本 ${tag}），已写入单元但未立即启动"
    log "稍后可执行: sudo ng start server"
  fi
}

cmd_install_client() {
  need_root "install-client"
  ensure_tools
  ensure_dirs
  ensure_user
  local arch tag asset
  arch="$(detect_arch)"
  tag="$(latest_tag)"
  [[ -n "$tag" ]] || die "无法获取最新 Release 版本"
  asset="nexusgate-edge-linux-${arch}"
  download_asset "$asset" "$EDGE_BIN"

  echo
  log "二进制已就绪，开始逐项配置客户端..."
  configure_client_interactive

  write_edge_unit
  fix_ownership
  echo "$tag" >"$VERSION_FILE"
  systemctl daemon-reload

  echo
  if ask_yn "写入 systemd 并启用开机自启，立即启动客户端?" "Y"; then
    systemctl enable "$EDGE_UNIT"
    systemctl restart "$EDGE_UNIT" || systemctl start "$EDGE_UNIT"
    if systemctl is-active --quiet "$EDGE_UNIT"; then
      log "客户端已安装并开机自启（版本 ${tag}）"
    else
      warn "客户端未能保持运行（常见原因：token 无效或服务端未启动）"
      warn "请检查: journalctl -u ${EDGE_UNIT} -xe"
      log "客户端已安装；修正配置后: sudo ng config-client && sudo ng start client"
    fi
  else
    systemctl enable "$EDGE_UNIT" || true
    log "客户端已安装（版本 ${tag}），已写入单元但未立即启动"
    log "稍后可执行: sudo ng start client"
  fi
}

cmd_install_web() {
  need_root "install-web"
  ensure_web_tools
  ensure_dirs
  ensure_user
  install_web_bin_from_release

  echo
  log "二进制已就绪，开始逐项配置管理面板..."
  configure_web_interactive

  write_web_unit
  fix_ownership
  systemctl daemon-reload

  local wp
  wp="$(toml_get "$WEB_CFG" listen_port "$DEFAULT_WEB_PORT")"

  echo
  if ask_yn "写入 systemd 并启用开机自启，立即启动管理面板?" "Y"; then
    systemctl enable "$WEB_UNIT"
    systemctl restart "$WEB_UNIT" || systemctl start "$WEB_UNIT"
    if systemctl is-active --quiet "$WEB_UNIT"; then
      log "管理面板已安装并开机自启（内嵌前端 + API 反代）"
      log "浏览器访问: http://<服务器IP>:${wp}  （默认账号见服务端配置）"
    else
      die "管理面板启动失败，请查看: journalctl -u ${WEB_UNIT} -xe"
    fi
  else
    systemctl enable "$WEB_UNIT" || true
    log "管理面板已安装，未立即启动。稍后: sudo ng start web"
  fi
}

cmd_update_web() {
  need_root "update-web"
  installed_web || die "管理面板未安装，请先: sudo ng install-web"
  ensure_web_tools
  local running=0
  if systemctl is-active --quiet "$WEB_UNIT"; then running=1; systemctl stop "$WEB_UNIT"; fi
  install_web_bin_from_release
  fix_ownership
  systemctl daemon-reload
  if ((running)); then
    systemctl start "$WEB_UNIT"
  fi
  log "管理面板已更新到 $(cat "${WEB_DIR}/version" 2>/dev/null || echo latest)"
}

cmd_update_server() {
  need_root "update-server"
  installed_server || die "服务端未安装，请先: sudo ng install-server"
  ensure_tools
  local arch tag asset running=0
  arch="$(detect_arch)"
  tag="$(latest_tag)"
  [[ -n "$tag" ]] || die "无法获取最新 Release"
  asset="nexusgate-server-linux-${arch}"
  if systemctl is-active --quiet "$SERVER_UNIT"; then running=1; systemctl stop "$SERVER_UNIT"; fi
  download_asset "$asset" "${SERVER_BIN}.new"
  mv -f "${SERVER_BIN}.new" "$SERVER_BIN"
  echo "$tag" >"$VERSION_FILE"
  fix_ownership
  systemctl daemon-reload
  systemctl start "$SERVER_UNIT"
  log "服务端已更新到 ${tag}"
}

cmd_update_client() {
  need_root "update-client"
  installed_client || die "客户端未安装，请先: sudo ng install-client"
  ensure_tools
  local arch tag asset running=0
  arch="$(detect_arch)"
  tag="$(latest_tag)"
  [[ -n "$tag" ]] || die "无法获取最新 Release"
  asset="nexusgate-edge-linux-${arch}"
  if systemctl is-active --quiet "$EDGE_UNIT"; then running=1; systemctl stop "$EDGE_UNIT"; fi
  download_asset "$asset" "${EDGE_BIN}.new"
  mv -f "${EDGE_BIN}.new" "$EDGE_BIN"
  echo "$tag" >"$VERSION_FILE"
  fix_ownership
  systemctl daemon-reload
  systemctl start "$EDGE_UNIT"
  log "客户端已更新到 ${tag}"
}

pick_target() {
  local t="${1:-}"
  case "$t" in
    server|s) echo server ;;
    client|edge|c|e) echo client ;;
    web|w|panel|ui) echo web ;;
    all|a|"") echo all ;;
    *) die "目标无效: $t（server|client|web|all）" ;;
  esac
}

cmd_start() {
  need_root "start"
  local t
  t="$(pick_target "${1:-all}")"
  case "$t" in
    server)
      installed_server || die "服务端未安装"
      svc_do start "$SERVER_UNIT"
      ;;
    client)
      installed_client || die "客户端未安装"
      svc_do start "$EDGE_UNIT"
      ;;
    web)
      installed_web || die "管理面板未安装"
      svc_do start "$WEB_UNIT"
      ;;
    all)
      installed_server && svc_do start "$SERVER_UNIT" || warn "跳过服务端（未安装）"
      installed_client && svc_do start "$EDGE_UNIT" || warn "跳过客户端（未安装）"
      installed_web && svc_do start "$WEB_UNIT" || warn "跳过管理面板（未安装）"
      ;;
  esac
  log "已启动: $t"
}

cmd_stop() {
  need_root "stop"
  local t
  t="$(pick_target "${1:-all}")"
  case "$t" in
    server) unit_exists "$SERVER_UNIT" && svc_do stop "$SERVER_UNIT" || true ;;
    client) unit_exists "$EDGE_UNIT" && svc_do stop "$EDGE_UNIT" || true ;;
    web) unit_exists "$WEB_UNIT" && svc_do stop "$WEB_UNIT" || true ;;
    all)
      unit_exists "$SERVER_UNIT" && svc_do stop "$SERVER_UNIT" || true
      unit_exists "$EDGE_UNIT" && svc_do stop "$EDGE_UNIT" || true
      unit_exists "$WEB_UNIT" && svc_do stop "$WEB_UNIT" || true
      ;;
  esac
  log "已停止: $t"
}

cmd_restart() {
  need_root "restart"
  local t
  t="$(pick_target "${1:-all}")"
  case "$t" in
    server)
      installed_server || die "服务端未安装"
      svc_do restart "$SERVER_UNIT"
      ;;
    client)
      installed_client || die "客户端未安装"
      svc_do restart "$EDGE_UNIT"
      ;;
    web)
      installed_web || die "管理面板未安装"
      svc_do restart "$WEB_UNIT"
      ;;
    all)
      installed_server && svc_do restart "$SERVER_UNIT" || warn "跳过服务端"
      installed_client && svc_do restart "$EDGE_UNIT" || warn "跳过客户端"
      installed_web && svc_do restart "$WEB_UNIT" || warn "跳过管理面板"
      ;;
  esac
  log "已重启: $t"
}

cmd_config_server() {
  need_root "config-server"
  ensure_dirs
  configure_server_interactive
  fix_ownership 2>/dev/null || true
  if unit_exists "$SERVER_UNIT"; then
    if ask_yn "配置已保存，是否立即重启服务端?" "Y"; then
      svc_do restart "$SERVER_UNIT"
      log "服务端已重启"
    fi
  else
    warn "服务端尚未安装 systemd 单元；安装后配置会自动生效"
  fi
}

cmd_config_client() {
  need_root "config-client"
  ensure_dirs
  configure_client_interactive
  fix_ownership 2>/dev/null || true
  if unit_exists "$EDGE_UNIT"; then
    if ask_yn "配置已保存，是否立即重启客户端?" "Y"; then
      svc_do restart "$EDGE_UNIT"
      log "客户端已重启"
    fi
  else
    warn "客户端尚未安装 systemd 单元；安装后配置会自动生效"
  fi
}

cmd_config_web() {
  need_root "config-web"
  ensure_web_tools
  ensure_dirs
  configure_web_interactive
  write_web_unit
  fix_ownership 2>/dev/null || true
  systemctl daemon-reload
  if unit_exists "$WEB_UNIT"; then
    if ask_yn "配置已保存，是否立即重启管理面板?" "Y"; then
      svc_do restart "$WEB_UNIT"
      log "管理面板已重启"
    fi
  else
    warn "管理面板尚未安装 systemd 单元；请先: sudo ng install-web"
  fi
}

purge_server_files() {
  rm -f "$SERVER_BIN" "${SERVER_BIN}.new"
  rm -rf "${PREFIX}/server"
  # server-owned data (sqlite etc.)
  rm -rf "$DATA_DIR"
  rm -f "/etc/systemd/system/${SERVER_UNIT}"
  rm -f "/etc/systemd/system/multi-user.target.wants/${SERVER_UNIT}"
}

purge_client_files() {
  rm -f "$EDGE_BIN" "${EDGE_BIN}.new"
  rm -rf "${PREFIX}/client"
  rm -f "/etc/systemd/system/${EDGE_UNIT}"
  rm -f "/etc/systemd/system/multi-user.target.wants/${EDGE_UNIT}"
}

purge_web_files() {
  unit_exists "$WEB_UNIT" && systemctl disable --now "$WEB_UNIT" 2>/dev/null || true
  rm -f "$WEB_BIN" "${WEB_BIN}.new"
  rm -rf "$WEB_DIR"
  rm -f "/etc/systemd/system/${WEB_UNIT}"
  rm -f "/etc/systemd/system/multi-user.target.wants/${WEB_UNIT}"
}

any_component_installed() {
  [[ -x "$SERVER_BIN" || -x "$EDGE_BIN" || -x "$WEB_BIN" ]]
}

maybe_purge_all() {
  # If no component remains, wipe prefix and system user
  if ! any_component_installed; then
    systemctl daemon-reload || true
    rm -rf "$PREFIX"
    if id -u "$SYSUSER" >/dev/null 2>&1; then
      userdel "$SYSUSER" 2>/dev/null || true
      log "已删除系统用户 ${SYSUSER}"
    fi
    log "已清理目录 ${PREFIX}"
  else
    systemctl daemon-reload || true
    fix_ownership 2>/dev/null || true
  fi
}

cmd_uninstall_server() {
  need_root "uninstall-server"
  warn "将完全卸载服务端：二进制、systemd、配置、数据库与数据目录"
  read -r -p "确认卸载服务端? 输入 yes 继续: " ans
  [[ "$ans" == "yes" ]] || die "已取消"
  unit_exists "$SERVER_UNIT" && systemctl disable --now "$SERVER_UNIT" 2>/dev/null || true
  purge_server_files
  maybe_purge_all
  log "服务端已完全卸载"
}

cmd_uninstall_client() {
  need_root "uninstall-client"
  warn "将完全卸载客户端：二进制、systemd、配置"
  read -r -p "确认卸载客户端? 输入 yes 继续: " ans
  [[ "$ans" == "yes" ]] || die "已取消"
  unit_exists "$EDGE_UNIT" && systemctl disable --now "$EDGE_UNIT" 2>/dev/null || true
  purge_client_files
  maybe_purge_all
  log "客户端已完全卸载"
}

cmd_uninstall_web() {
  need_root "uninstall-web"
  warn "将完全卸载管理面板：二进制、systemd 与配置"
  read -r -p "确认卸载管理面板? 输入 yes 继续: " ans
  [[ "$ans" == "yes" ]] || die "已取消"
  purge_web_files
  maybe_purge_all
  log "管理面板已完全卸载"
}

cmd_uninstall_all() {
  need_root "uninstall-all"
  warn "将卸载服务端+客户端+管理面板，并删除 ${PREFIX}、systemd 单元与用户 ${SYSUSER}"
  read -r -p "确认完全卸载 NexusGate? 输入 YES 继续: " ans
  [[ "$ans" == "YES" ]] || die "已取消"
  unit_exists "$SERVER_UNIT" && systemctl disable --now "$SERVER_UNIT" 2>/dev/null || true
  unit_exists "$EDGE_UNIT" && systemctl disable --now "$EDGE_UNIT" 2>/dev/null || true
  unit_exists "$WEB_UNIT" && systemctl disable --now "$WEB_UNIT" 2>/dev/null || true
  purge_server_files
  purge_client_files
  purge_web_files
  systemctl daemon-reload || true
  rm -rf "$PREFIX"
  if id -u "$SYSUSER" >/dev/null 2>&1; then
    userdel "$SYSUSER" 2>/dev/null || true
  fi
  if [[ -L "$NG_LINK" || -f "$NG_LINK" ]]; then
    read -r -p "是否同时删除管理命令 ${NG_LINK}? [y/N] " rmng
    if [[ "${rmng:-N}" =~ ^[Yy]$ ]]; then
      rm -f "$NG_LINK"
      log "已删除 ${NG_LINK}"
    fi
  fi
  log "NexusGate 已完全卸载"
}

cmd_uninstall_ng() {
  need_root "uninstall-ng"
  echo -e "${BOLD}卸载管理脚本 ng${NC}"
  echo
  echo "将删除:"
  echo "  - ${NG_LINK}"
  [[ -f "${PREFIX}/scripts/ng" ]] && echo "  - ${PREFIX}/scripts/ng"
  echo
  if installed_server || installed_client || installed_web; then
    warn "注意: 服务端/客户端/管理面板仍保留，不会随 ng 一并删除。"
    warn "若要连同组件一起清掉，请用菜单「完全卸载全部」或: sudo ng uninstall-all"
    echo
  fi
  read -r -p "确认卸载 ng 管理脚本? 输入 yes 继续: " ans
  [[ "$ans" == "yes" ]] || die "已取消"

  local removed=0
  if [[ -L "$NG_LINK" || -f "$NG_LINK" ]]; then
    rm -f "$NG_LINK"
    log "已删除 ${NG_LINK}"
    removed=1
  else
    warn "未找到 ${NG_LINK}"
  fi
  if [[ -f "${PREFIX}/scripts/ng" ]]; then
    rm -f "${PREFIX}/scripts/ng"
    rmdir "${PREFIX}/scripts" 2>/dev/null || true
    log "已删除 ${PREFIX}/scripts/ng"
    removed=1
  fi

  if ((removed)); then
    log "ng 管理脚本已卸载。之后可重新安装:"
    echo "  curl -fsSL https://raw.githubusercontent.com/${REPO}/main/scripts/install-ng.sh | sudo bash"
  else
    warn "没有可删除的 ng 脚本文件"
  fi
}

cmd_status() {
  echo -e "${BOLD}NexusGate 状态${NC}"
  echo "安装目录: ${PREFIX}"
  local mir
  mir="$(saved_mirror)"
  if [[ -n "${NG_MIRROR:-}" ]]; then
    echo "下载镜像: ${NG_MIRROR} (NG_MIRROR)"
  elif [[ -n "$mir" ]]; then
    echo "下载镜像: ${mir}"
  else
    echo "下载镜像: 官方优先 + 自动故障转移"
  fi
  if [[ -f "$VERSION_FILE" ]]; then
    echo "本地版本: $(cat "$VERSION_FILE")"
  else
    echo "本地版本: (未知)"
  fi
  local remote=""
  remote="$(latest_tag 2>/dev/null || true)"
  [[ -n "$remote" ]] && echo "GitHub 最新: ${remote}"
  echo
  if installed_server || unit_exists "$SERVER_UNIT"; then
    echo -e "${CYAN}服务端${NC}: $(systemctl is-active "$SERVER_UNIT" 2>/dev/null || echo unknown) / $(systemctl is-enabled "$SERVER_UNIT" 2>/dev/null || echo unknown)"
    echo "  二进制: $SERVER_BIN"
    echo "  配置:   $SERVER_CFG"
    echo "  数据:   $DATA_DIR"
  else
    echo -e "${CYAN}服务端${NC}: 未安装"
  fi
  echo
  if installed_client || unit_exists "$EDGE_UNIT"; then
    echo -e "${CYAN}客户端${NC}: $(systemctl is-active "$EDGE_UNIT" 2>/dev/null || echo unknown) / $(systemctl is-enabled "$EDGE_UNIT" 2>/dev/null || echo unknown)"
    echo "  二进制: $EDGE_BIN"
    echo "  配置:   $CLIENT_CFG"
  else
    echo -e "${CYAN}客户端${NC}: 未安装"
  fi
  echo
  if installed_web || unit_exists "$WEB_UNIT"; then
    echo -e "${CYAN}管理面板${NC}: $(systemctl is-active "$WEB_UNIT" 2>/dev/null || echo unknown) / $(systemctl is-enabled "$WEB_UNIT" 2>/dev/null || echo unknown)"
    echo "  二进制: $WEB_BIN"
    echo "  配置:   $WEB_CFG"
    echo "  访问:   http://0.0.0.0:$(toml_get "$WEB_CFG" listen_port "$DEFAULT_WEB_PORT")"
  else
    echo -e "${CYAN}管理面板${NC}: 未安装"
  fi
}

print_config_file() {
  local title="$1"
  local file="$2"
  echo
  echo -e "${BOLD}-------- ${title} --------${NC}"
  echo "路径: ${file}"
  if [[ ! -f "$file" ]]; then
    warn "配置文件不存在"
    return 0
  fi
  echo "----- 内容 -----"
  cat "$file"
  echo
  echo "----- 结束 -----"
}

cmd_show_config() {
  local t="${1:-}"
  if [[ -z "$t" ]]; then
    t="all"
  fi
  case "$t" in
    server|s|client|c|edge|e|web|w|panel|ui|all|a) ;;
    *) die "目标无效: $t（server|client|web|all）" ;;
  esac
  t="$(pick_target "$t")"

  echo -e "${BOLD}NexusGate 当前配置${NC}"
  case "$t" in
    server)
      print_config_file "服务端" "$SERVER_CFG"
      ;;
    client)
      print_config_file "客户端" "$CLIENT_CFG"
      ;;
    web)
      print_config_file "管理面板" "$WEB_CFG"
      ;;
    all)
      print_config_file "服务端" "$SERVER_CFG"
      print_config_file "客户端" "$CLIENT_CFG"
      print_config_file "管理面板" "$WEB_CFG"
      ;;
  esac
}

cmd_logs() {
  local t
  t="$(pick_target "${1:-server}")"
  case "$t" in
    server) journalctl -u "$SERVER_UNIT" -f --no-pager ;;
    client) journalctl -u "$EDGE_UNIT" -f --no-pager ;;
    web)
      echo "systemd: journalctl -u ${WEB_UNIT}"
      journalctl -u "$WEB_UNIT" -f --no-pager
      ;;
    all)
      journalctl -u "$SERVER_UNIT" -u "$EDGE_UNIT" -u "$WEB_UNIT" -f --no-pager
      ;;
  esac
}

cmd_self_update() {
  need_root "self-update"
  ensure_dirs
  local tmp
  tmp="$(mktemp)"
  download_url_failover "${GITHUB_RAW}/scripts/ng" "$tmp"
  sed -i 's/\r$//' "$tmp" 2>/dev/null || true
  chmod 755 "$tmp"
  grep -q 'NexusGate Linux manager' "$tmp" || die "下载的脚本校验失败"
  install -m 755 "$tmp" "$NG_LINK"
  rm -f "$tmp"
  if [[ -d "$PREFIX" ]]; then
    mkdir -p "${PREFIX}/scripts"
    cp -f "$NG_LINK" "${PREFIX}/scripts/ng"
  fi
  log "管理脚本已更新: ${NG_LINK}"
}

print_help() {
  cat <<EOF
${BOLD}NexusGate 管理工具${NC}  (${NG_CMD_NAME})

直接运行进入数字菜单:
  sudo ng
  ng              # 非 root 时会自动请求 sudo

也可直接传命令:
  sudo ng <命令> [参数]

安装 / 更新 / 卸载:
  install-server          安装服务端：下载 → 逐项配置 → systemd 自启
  install-client          安装客户端：下载 → 逐项配置 → systemd 自启
  install-web             安装管理面板：下载内嵌前端的 p2p-admin → 逐项配置 → 自启
  update-server           更新服务端到 GitHub 最新 Release
  update-client           更新客户端到 GitHub 最新 Release
  update-web              更新管理面板二进制到最新 Release
  uninstall-server        完全卸载服务端（含配置与数据）
  uninstall-client        完全卸载客户端（含配置）
  uninstall-web           完全卸载管理面板
  uninstall-all           卸载全部并清理 /opt/nexusgate 与系统用户
  uninstall-ng            仅卸载管理脚本 ng（不影响已装组件）

运行控制:
  start   [server|client|web|all]    启动（默认 all）
  stop    [server|client|web|all]    停止
  restart [server|client|web|all]    重启
  status                             查看状态
  logs    [server|client|web|all]    跟踪日志

配置:
  config-server           逐项交互配置服务端（可选重启）
  config-client           逐项交互配置客户端（可选重启）
  config-web              逐项交互配置管理面板端口/API 反代
  show-config [server|client|web|all]  查看当前配置（默认 all）

其它:
  mirror                  设置 GitHub 镜像源（下载故障转移）
  test-mirror             探测官方/镜像可用性
  self-update             更新本管理脚本 ng
  help                    显示帮助
  menu                    交互菜单（默认）

示例:
  sudo ng
  sudo ng install-server
  sudo ng install-web
  sudo ng show-config web
  sudo ng restart web
EOF
}

ask_target() {
  # $1 = default label for hint: all|server|web
  # 提示必须打到 stderr，避免被 t="$(ask_target)" 吃掉
  local def="${1:-all}"
  local def_num=4
  case "$def" in
    server) def_num=1 ;;
    client) def_num=2 ;;
    web) def_num=3 ;;
    *) def_num=4 ;;
  esac
  echo >&2
  echo "  选择目标:" >&2
  echo "    1) server  (服务端)" >&2
  echo "    2) client  (客户端)" >&2
  echo "    3) web     (管理面板)" >&2
  echo "    4) all     (全部)" >&2
  echo -n "  请输入数字 [默认 ${def_num}]: " >&2
  local c
  read -r c || true
  if [[ -z "$c" ]]; then
    echo "$def"
    return 0
  fi
  case "$c" in
    1) echo server ;;
    2) echo client ;;
    3) echo web ;;
    4) echo all ;;
    server|s) echo server ;;
    client|c|edge|e) echo client ;;
    web|w|panel|ui) echo web ;;
    all|a) echo all ;;
    *)
      warn "无效选择，使用默认: $def"
      echo "$def"
      ;;
  esac
}

pause() {
  echo
  echo -n "按回车返回菜单..."
  read -r _ || true
}

ng_manager_installed() {
  [[ -f "$NG_LINK" || -L "$NG_LINK" ]]
}

# 菜单操作结束后：若 ng 已被卸掉则直接退出，不再回菜单
menu_finish() {
  if ! ng_manager_installed; then
    echo
    log "管理脚本 ng 已不存在，退出。"
    exit 0
  fi
  pause
}

# 在菜单中执行命令：失败只提示，不退出整个菜单（0 退出 / 已卸 ng 除外）
menu_run() {
  set +e
  (
    set -euo pipefail
    "$@"
  )
  local ec=$?
  set -e
  if ((ec != 0)); then
    echo
    warn "操作未成功完成（退出码 ${ec}），即将返回菜单"
  fi
  return 0
}

ensure_root_or_reexec() {
  if [[ ${EUID} -ne 0 ]]; then
    if have_cmd sudo; then
      log "需要管理员权限，正在通过 sudo 重新启动..."
      exec sudo -E "$0" "$@"
    fi
    die "请使用 root 运行：sudo ng"
  fi
}

menu() {
  ensure_root_or_reexec menu
  while true; do
    clear 2>/dev/null || true
    echo
    echo -e "${BOLD}======== NexusGate 管理菜单 ========${NC}"
    echo -e "  命令: ${CYAN}ng${NC}  |  目录: ${PREFIX}"
    if [[ -f "$VERSION_FILE" ]]; then
      echo -e "  本地版本: $(cat "$VERSION_FILE")"
    fi
    local _m
    _m="$(saved_mirror 2>/dev/null || true)"
    if [[ -n "${NG_MIRROR:-}" ]]; then
      echo -e "  下载镜像: ${CYAN}${NG_MIRROR}${NC} (环境变量)"
    elif [[ -n "${_m}" ]]; then
      echo -e "  下载镜像: ${CYAN}${_m}${NC}"
    else
      echo -e "  下载镜像: 官方优先 + 自动故障转移"
    fi
    echo
    echo "  -------- 安装 / 更新 --------"
    echo "   1) 安装服务端（下载后逐项配置再自启）"
    echo "   2) 安装客户端（下载后逐项配置再自启）"
    echo "  21) 安装管理面板（内嵌前端的 Rust 反代）"
    echo "   3) 更新服务端（GitHub 最新）"
    echo "   4) 更新客户端（GitHub 最新）"
    echo "  22) 更新管理面板"
    echo
    echo "  -------- 运行控制 --------"
    echo "   5) 启动"
    echo "   6) 重启"
    echo "   7) 关闭"
    echo "   8) 查看状态"
    echo "   9) 查看日志"
    echo
    echo "  -------- 配置 --------"
    echo "  10) 配置服务端（逐项设置）"
    echo "  11) 配置客户端（逐项设置）"
    echo "  23) 配置管理面板（端口 / API 反代）"
    echo "  20) 查看当前配置"
    echo
    echo "  -------- 卸载 --------"
    echo "  12) 卸载客户端（完全清理）"
    echo "  13) 卸载服务端（完全清理）"
    echo "  24) 卸载管理面板（完全清理）"
    echo "  14) 完全卸载全部（含组件）"
    echo "  19) 卸载 ng 管理脚本"
    echo
    echo "  -------- 其它 --------"
    echo "  15) 更新本管理脚本 ng"
    echo "  16) 显示命令帮助"
    echo "  17) 设置 GitHub 镜像源"
    echo "  18) 测试镜像/官方下载"
    echo "   0) 退出"
    echo
    echo -n "请输入数字选择功能: "
    local choice t
    read -r choice || true
    echo
    case "$choice" in
      1)
        menu_run cmd_install_server
        menu_finish
        ;;
      2)
        menu_run cmd_install_client
        menu_finish
        ;;
      21)
        menu_run cmd_install_web
        menu_finish
        ;;
      3)
        menu_run cmd_update_server
        menu_finish
        ;;
      4)
        menu_run cmd_update_client
        menu_finish
        ;;
      22)
        menu_run cmd_update_web
        menu_finish
        ;;
      5)
        t="$(ask_target all)"
        menu_run cmd_start "$t"
        menu_finish
        ;;
      6)
        t="$(ask_target all)"
        menu_run cmd_restart "$t"
        menu_finish
        ;;
      7)
        t="$(ask_target all)"
        menu_run cmd_stop "$t"
        menu_finish
        ;;
      8)
        menu_run cmd_status
        menu_finish
        ;;
      9)
        t="$(ask_target server)"
        echo "开始跟踪日志，Ctrl+C 结束并返回菜单..."
        sleep 1
        set +e
        cmd_logs "$t"
        set -e
        menu_finish
        ;;
      10)
        menu_run cmd_config_server
        menu_finish
        ;;
      11)
        menu_run cmd_config_client
        menu_finish
        ;;
      23)
        menu_run cmd_config_web
        menu_finish
        ;;
      20)
        t="$(ask_target all)"
        menu_run cmd_show_config "$t"
        menu_finish
        ;;
      12)
        menu_run cmd_uninstall_client
        menu_finish
        ;;
      13)
        menu_run cmd_uninstall_server
        menu_finish
        ;;
      24)
        menu_run cmd_uninstall_web
        menu_finish
        ;;
      14)
        menu_run cmd_uninstall_all
        menu_finish
        ;;
      15)
        menu_run cmd_self_update
        menu_finish
        ;;
      16)
        print_help
        menu_finish
        ;;
      17)
        menu_run cmd_mirror
        menu_finish
        ;;
      18)
        menu_run cmd_test_mirror
        menu_finish
        ;;
      19)
        menu_run cmd_uninstall_ng
        # 卸掉 ng 后直接退出，不回菜单、不 pause
        menu_finish
        ;;
      0|q|Q)
        echo "已退出。"
        exit 0
        ;;
      *)
        warn "无效选项: ${choice}（请输入菜单中的数字）"
        sleep 1
        ;;
    esac
  done
}

main() {
  # 无参数 -> 数字菜单
  if [[ $# -eq 0 ]]; then
    menu
    return
  fi

  local cmd="$1"
  shift || true
  case "$cmd" in
    install-server|is) cmd_install_server "$@" ;;
    install-client|ic) cmd_install_client "$@" ;;
    install-web|iw)    cmd_install_web "$@" ;;
    update-server|us)  cmd_update_server "$@" ;;
    update-client|uc)  cmd_update_client "$@" ;;
    update-web|uw)     cmd_update_web "$@" ;;
    uninstall-server|rs) cmd_uninstall_server "$@" ;;
    uninstall-client|rc) cmd_uninstall_client "$@" ;;
    uninstall-web|rw)    cmd_uninstall_web "$@" ;;
    uninstall-all|ra)    cmd_uninstall_all "$@" ;;
    uninstall-ng|rng)    cmd_uninstall_ng "$@" ;;
    start)   cmd_start "$@" ;;
    stop)    cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    config-server|cs) cmd_config_server "$@" ;;
    config-client|cc) cmd_config_client "$@" ;;
    config-web|cw)    cmd_config_web "$@" ;;
    show-config|sc|view-config|vc) cmd_show_config "$@" ;;
    status|st) cmd_status "$@" ;;
    logs|log)  cmd_logs "$@" ;;
    self-update) cmd_self_update "$@" ;;
    mirror|mirrors) cmd_mirror "$@" ;;
    test-mirror|tm) cmd_test_mirror "$@" ;;
    menu|m) menu ;;
    help|-h|--help) print_help ;;
    *)
      err "未知命令: $cmd"
      echo
      print_help
      echo
      echo -n "是否进入数字菜单? [Y/n] "
      local ans
      read -r ans
      ans="${ans:-Y}"
      if [[ "$ans" =~ ^[Yy]$ ]]; then
        menu
      else
        exit 1
      fi
      ;;
  esac
}

main "$@"
