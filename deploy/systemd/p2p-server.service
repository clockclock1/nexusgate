[Unit]
Description=NexusGate Server
After=network.target

[Service]
Type=simple
User=nexusgate
WorkingDirectory=/opt/nexusgate
ExecStart=/usr/local/bin/p2p-server --config /opt/nexusgate/server/config/server.toml
Restart=always
RestartSec=3
LimitNOFILE=1048576
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
