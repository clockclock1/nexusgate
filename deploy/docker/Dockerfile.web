# syntax=docker/dockerfile:1.7
FROM debian:stable-slim
ARG TARGETARCH
WORKDIR /opt/nexusgate
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --chmod=755 dist/nexusgate-admin-linux-${TARGETARCH} /usr/local/bin/p2p-admin
COPY admin/config/admin.toml /opt/nexusgate/web/config/admin.toml
ENV RUST_LOG=info
EXPOSE 8088
ENTRYPOINT ["p2p-admin", "--config", "/opt/nexusgate/web/config/admin.toml"]
